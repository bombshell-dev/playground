{
	"name": "@bomb.sh/playground",
	"version": "0.0.0",
	"keywords": [
		"bombshell",
		"cli"
	],
	"homepage": "https://bomb.sh/docs/playground",
	"license": "MIT",
	"author": {
		"name": "Bombshell",
		"email": "oss@bomb.sh",
		"url": "https://bomb.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bombshell-dev/playground.git"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"playground": "NODE_NO_WARNINGS=1 node --experimental-transform-types ./scripts/playground.ts",
		"format": "bsh format",
		"format:check": "bsh format --check",
		"lint": "bsh lint .",
		"typecheck": "pnpm --filter ghostwright build && tsc --noEmit && pnpm -r --if-present run typecheck",
		"test": "vitest run --exclude '**/node_modules/**' --exclude 'experiments/ghostwright/**' --exclude 'packages/**'",
		"dev:repos": "node scripts/dev-repos.mjs",
		"test:dev-repos": "node --test scripts/check-dev-repos.mjs",
		"dev:build-ui": "pnpm --dir .dev/workspace --filter @clack/ui --filter @clack/ui-preact run build",
		"test:linked-ui": "pnpm --dir .dev/workspace --filter @ghostwright/pizza-preact exec vitest run --config integration/vitest.config.ts",
		"test:pizza": "pnpm --dir .dev/workspace --filter @ghostwright/pizza --filter @ghostwright/pizza-preact test && pnpm --dir .dev/workspace --filter @ghostwright/pizza test:in-process && pnpm test:linked-ui",
		"typecheck:pizza": "pnpm --dir .dev/workspace --filter @ghostwright/pizza-preact typecheck && tsc -p packages/pizza/spikes/tsconfig.json && tsc -p packages/pizza-preact/integration/tsconfig.json"
	},
	"devDependencies": {
		"@bomb.sh/args": "catalog:",
		"@bomb.sh/tools": "^0.6.1",
		"@clack/prompts": "catalog:",
		"@types/node": "^22",
		"typescript": "^5.9.3",
		"vitest": "^4.1.9",
		"yaml": "^2.9.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "10.7.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "22.14.0",
			"onFail": "error"
		}
	},
	"pnpm": {
		"overrides": {
			"@bomb.sh/tty": "https://pkg.pr.new/@bomb.sh/tty@103"
		}
	}
}
