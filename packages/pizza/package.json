{
	"name": "@ghostwright/pizza",
	"version": "0.0.0",
	"private": true,
	"description": "A clack/ui pizza delivery form with a card dialog, validated with ghostwright tree locators",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"start": "tsx src/pizza.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@bomb.sh/tty": "^0.8.0",
		"@clack/ui": "workspace:*",
		"@ghostwright/clack-tty": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.20.0",
		"ghostwright": "workspace:*",
		"tsx": "^4.19.0",
		"vitest": "^4.1.9"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "10.7.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "22.14.0",
			"onFail": "error"
		}
	},
	"@clack/ui": {
		"extensions": [
			"@ghostwright/clack-tty/auto"
		]
	}
}
