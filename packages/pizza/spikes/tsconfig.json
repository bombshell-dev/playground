		"paths": {
			"ghostwright": ["../../../experiments/ghostwright/src/index.ts"],
			"ghostwright/vitest": ["../../../experiments/ghostwright/src/vitest.ts"],
			"ghostwright/matchers": ["../../../experiments/ghostwright/src/runner-matchers.ts"]
